# Copy to .env (in this folder or in backend/) and adjust. Never commit a real .env.
# Database: SQLite for local development. For PostgreSQL later:
#   DATABASE_URL=postgresql+psycopg://glucosync:CHANGE_ME@localhost:5432/glucosync  (pip install "psycopg[binary]")
DATABASE_URL=sqlite:///./glucosync.db

# Login sessions (server-side, HttpOnly cookie)
SESSION_HOURS=12
SESSION_COOKIE_NAME=glucosync_session
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Exact frontend origins allowed to call the API (no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Display timezone for dates/times (IANA name). Stored timestamps are always UTC.
APP_TIMEZONE=Asia/Kolkata

# Simulation
SIMULATION_INTERVAL_SECONDS=5
# After a server restart, simulations that were running are marked stopped (false) or resumed (true)
SIMULATION_RESUME_ON_RESTART=false

# Demo data (development only; seeded accounts use password Demo123!)
SEED_DEMO_DATA=true

# Prototype alert rules file (see backend/thresholds.json)
# THRESHOLDS_FILE=./backend/thresholds.json

# Placeholder escalation policy for unacknowledged alerts (the hospital must approve real values)
RED_ESCALATION_MINUTES=10
ORANGE_ESCALATION_MINUTES=30

# Mock HIS: fraction of sharing attempts that fail on purpose, to demonstrate failure tracking
HIS_MOCK_FAILURE_RATE=0.05
CONSENT_VERSION=1.0

# Future real-sensor gateway key for POST /api/devices/readings (empty = endpoint disabled)
DEVICE_API_KEY=
